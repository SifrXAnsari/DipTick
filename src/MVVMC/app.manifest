<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  diptick.exe's manifest. It stays a console program (CLI first): a shell waits for it and its verbs
  print where they were run. Started from Explorer or a shortcut, "detached" keeps Windows from
  making a console for it, so the window opens alone ("Console Allocation Policy", Microsoft Learn:
  Windows 11 24H2, build 26100, and later). Older Windows ignores the element, and DipTick
  lets go of the console it was given (Controllers\ConsoleHost.cs). asInvoker: DipTick never asks to
  run elevated.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="DipTick.diptick" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <application>
    <windowsSettings>
      <consoleAllocationPolicy xmlns="http://schemas.microsoft.com/SMI/2024/WindowsSettings">detached</consoleAllocationPolicy>
    </windowsSettings>
  </application>
</assembly>
