<?xml version="1.0" encoding="utf-8"?>
<!-- Packages come from nuget.org alone, whatever else the machine's own NuGet settings name. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
